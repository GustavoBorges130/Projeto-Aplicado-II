# Copie este arquivo para .env

# --- Opção 1: PostgreSQL instalado na sua máquina ---
PORT=3000
PGHOST=localhost
PGPORT=5432
PGDATABASE=canjicatech
PGUSER=postgres
PGPASSWORD=postgres

# --- Opção 2: banco na nuvem (Neon / Vercel) ---
# Se DATABASE_URL estiver preenchida, ela é usada no lugar das variáveis acima.
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
